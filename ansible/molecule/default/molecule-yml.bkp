---
dependency:
  name: galaxy

driver:
  name: docker

platforms:
  - name: ns1
    image: geerlingguy/docker-amazonlinux2-ansible
    privileged: true

  - name: ns2
    image: geerlingguy/docker-amazonlinux2-ansible
    privileged: true

provisioner:
  name: ansible

  inventory:
    host_vars:
      ns1:
        ansible_connection: docker
        ansible_user: root

      ns2:
        ansible_connection: docker
        ansible_user: root

    hosts:
      all:
        hosts:
          ns1:
          ns2:
verifier:
  name: ansible
